# Optional. If set, contact forms send from this Google Workspace mailbox
# (travel@athlas.org or info@athlas.org) instead of the FormSubmit fallback.
# Create an App Password for that mailbox; do not use the normal login password.
CONTACT_SMTP_HOST=smtp.gmail.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_USER=travel@athlas.org
CONTACT_SMTP_PASS=
